# Server
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000

# Redis — job queue (BullMQ) + API caches
REDIS_URL=redis://localhost:6379
WEBHOOK_WORKER_CONCURRENCY=10
MEDIA_WORKER_CONCURRENCY=3
AI_WORKER_CONCURRENCY=3
AGENT_WORKER_CONCURRENCY=5
AI_JOB_TTL_SECONDS=300
WEBHOOK_JOB_TIMEOUT_MS=30000
MEDIA_JOB_TIMEOUT_MS=60000
AI_JOB_TIMEOUT_MS=25000
AGENT_JOB_TIMEOUT_MS=35000
CACHE_AUTH_TTL_SECONDS=120
CACHE_SUBSCRIPTION_TTL_SECONDS=60

# Auth rate limits (per IP unless noted)
RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_REGISTER_MAX=5
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_OTP_MAX=5
RATE_LIMIT_AUTH_OTP_WINDOW_SECONDS=900

# AI rate limits (per organization)
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_SECONDS=900

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Freemium: free trial length, then paid period length (days)
TRIAL_DURATION_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

# WhatsApp / Meta
WHATSAPP_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Instagram
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/auth/instagram/callback

# AI (OpenAI) — suggest reply, translate, conversation analytics
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000

# Business agent — automatic FAQ replies (opt-in per organization in Settings)
AGENT_ENABLED=true
AGENT_DAILY_REPLY_LIMIT=10
AGENT_JOB_DEBOUNCE_MS=4000

# Business profile URL fetching — agent reads live website/social page content
BUSINESS_URL_FETCH_ENABLED=true
BUSINESS_URL_FETCH_TIMEOUT_MS=8000
BUSINESS_URL_FETCH_MAX_BYTES=500000
BUSINESS_URL_CONTEXT_MAX_CHARS_PER_URL=2500
BUSINESS_URL_MAX_SUBPAGES=5
BUSINESS_URL_CONTEXT_CACHE_TTL_SECONDS=86400

# Catalogue document indexing — agent reads uploaded PDF/DOCX/XLSX/TXT files
BUSINESS_CATALOGUE_INDEX_ENABLED=true
BUSINESS_CATALOGUE_EXTRACT_MAX_CHARS_PER_FILE=50000
BUSINESS_CATALOGUE_CHUNK_SIZE_CHARS=800
BUSINESS_CATALOGUE_CHUNK_OVERLAP_CHARS=100
BUSINESS_CATALOGUE_MAX_CHUNKS_PER_ORG=200
BUSINESS_CATALOGUE_CONTEXT_MAX_CHARS=3500
BUSINESS_CATALOGUE_RETRIEVAL_TOP_CHUNKS=6

# Razorpay — GST-inclusive plan amounts are defined in code; create matching Plans in the Dashboard.
# Webhook URL (test/live): https://your-api-host/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_SCALE=
RAZORPAY_PLAN_ENTERPRISE=

# Optional Razorpay tuning
RAZORPAY_REQUEST_TIMEOUT_MS=15000
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
