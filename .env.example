# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth context cache (seconds)
AUTH_CONTEXT_CACHE_TTL_SECONDS=300

# Freemium: free trial length, then paid period length (days)
TRIAL_DURATION_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Integrations list cache (seconds)
INTEGRATIONS_LIST_CACHE_TTL_SECONDS=60

# Meta / WhatsApp (Phase 5)
META_APP_ID=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
WEBHOOK_VERIFY_TOKEN=
