# Server
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000

# Redis — job queue (BullMQ) + API caches
REDIS_URL=redis://localhost:6379
WEBHOOK_WORKER_CONCURRENCY=10
MEDIA_WORKER_CONCURRENCY=3
AI_WORKER_CONCURRENCY=3
AI_JOB_TTL_SECONDS=300
WEBHOOK_JOB_TIMEOUT_MS=30000
MEDIA_JOB_TIMEOUT_MS=60000
AI_JOB_TIMEOUT_MS=25000
CACHE_AUTH_TTL_SECONDS=120
CACHE_SUBSCRIPTION_TTL_SECONDS=60

# Auth rate limits (per IP unless noted)
RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_REGISTER_MAX=5
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_OTP_MAX=5
RATE_LIMIT_AUTH_OTP_WINDOW_SECONDS=900

# AI rate limits (per organization)
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_SECONDS=900

# CORS — comma-separated frontend origins (used for API CORS + Instagram OAuth postMessage)
# Production example:
# CORS_ORIGINS=https://www.responza.in,https://responza.in
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Freemium: free trial length (days)
TRIAL_DURATION_DAYS=3

# Admin dashboard — separate from organization accounts (not linked from the app UI)
# Example:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-secret
# ADMIN_SESSION_SECRET=optional-override-for-token-signing
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# WhatsApp / Meta
WHATSAPP_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Instagram — redirect URI must exactly match VITE_INSTAGRAM_REDIRECT_URI / Meta app settings
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Recommended production redirect:
# INSTAGRAM_REDIRECT_URI=https://www.responza.in/oauth/instagram/callback
# Legacy backend callback:
# INSTAGRAM_REDIRECT_URI=https://your-api-host/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:5173/oauth/instagram/callback

# Gmail OAuth — redirect URI must exactly match VITE_GMAIL_REDIRECT_URI / Google Cloud console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Recommended production redirect:
# GMAIL_REDIRECT_URI=https://www.responza.in/oauth/gmail/callback
# Legacy backend callback:
# GMAIL_REDIRECT_URI=https://your-api-host/auth/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:5173/oauth/gmail/callback

# AI (OpenAI) — suggest reply, translate, conversation analytics
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000

# Razorpay — GST-inclusive plan amounts are defined in code; create matching Plans in the Dashboard.
# Test: RAZORPAY_KEY_ID starts with rzp_test_ — use test plan IDs and test webhook secret.
# Live: RAZORPAY_KEY_ID starts with rzp_live_ — use live plan IDs and live webhook secret.
# Webhook URL (test/live): https://your-api-host/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
# Responza Annual (yearly ₹4,999) — example: plan_TBNt8pJIlps9kJ
RAZORPAY_PLAN_PREMIUM=plan_TBNt8pJIlps9kJ

# Optional Razorpay tuning
RAZORPAY_REQUEST_TIMEOUT_MS=15000
# Used for monthly plans; yearly plans are capped at 100 (Razorpay limit).
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
