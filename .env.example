# Copy to `.env` for local development (single file runs both API and worker).
# On Render: split by section — SHARED + API on the web service, SHARED + WORKER on the worker.

# =============================================================================
# SHARED — set on both Render services (API + Worker)
# =============================================================================
NODE_ENV=development
REDIS_URL=redis://localhost:6379

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=message-media

AI_ENABLED=false
OPENAI_API_KEY=

WHATSAPP_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# =============================================================================
# API — Render web service (`npm start` / `npm run dev`)
# =============================================================================
PORT=4000
TRUST_PROXY_HOPS=1
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000

# Comma-separated frontend origins (CORS + OAuth postMessage)
# CORS_ORIGINS=https://www.responza.in,https://responza.in
CORS_ORIGINS=http://localhost:5173

CACHE_AUTH_TTL_SECONDS=120
CACHE_SUBSCRIPTION_TTL_SECONDS=60

RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_REGISTER_MAX=5
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_OTP_MAX=5
RATE_LIMIT_AUTH_OTP_WINDOW_SECONDS=900
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_SECONDS=900

TRIAL_DURATION_DAYS=3

ADMIN_USERNAME=
ADMIN_PASSWORD=

INSTAGRAM_REDIRECT_URI=http://localhost:5173/oauth/instagram/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5173/oauth/gmail/callback

OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000
AI_JOB_TTL_SECONDS=300

# Knowledge ask (sync on API — Phase D)
KNOWLEDGE_CHAT_MODEL=gpt-4.1-mini
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.75

# Razorpay — webhook URL: https://your-api-host/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PREMIUM=plan_TBNt8pJIlps9kJ
RAZORPAY_REQUEST_TIMEOUT_MS=15000
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# =============================================================================
# WORKER — Render background worker (`npm run start:worker` / `npm run dev:worker`)
# =============================================================================
WEBHOOK_WORKER_CONCURRENCY=10
WEBHOOK_JOB_TIMEOUT_MS=30000

MEDIA_WORKER_CONCURRENCY=3
MEDIA_JOB_TIMEOUT_MS=60000

AI_WORKER_CONCURRENCY=3
AI_JOB_TIMEOUT_MS=25000

KNOWLEDGE_WORKER_CONCURRENCY=2
KNOWLEDGE_JOB_TIMEOUT_MS=180000
KNOWLEDGE_JOB_MAX_ATTEMPTS=3
KNOWLEDGE_JOB_RETRY_DELAY_SECONDS=5

# Knowledge ingest/index (async on worker — Phase B/C)
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-large
KNOWLEDGE_EMBEDDING_DIMENSIONS=3072
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=200
